# Copy to .env.local and fill in. .env.local is gitignored.

# Odoo in WSL (set up by: npm run odoo:setup)
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=mcl
ODOO_USER=admin
ODOO_PASSWORD=admin
WSL_DISTRO=Ubuntu-22.04

# Gmail: the "supplier" account sends, the demo buyer inbox receives.
# GMAIL_APP_PASSWORD is an App password of the supplier account
# (Google Account > Security > 2-Step Verification > App passwords).
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
GMAIL_INBOX=

# Optional: path to chrome.exe if it isn't in the usual place.
CHROME_PATH=
# Port the demo Chrome opens for the workflow runner.
CDP_PORT=9222

# Claude API key for the Knowledge tab (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=

# Test runs in Freestyle VMs (docs/vm-plan.md). Create a key with: npx freestyle tokens create "mcl-demo"
FREESTYLE_API_KEY=
# App password of the demo inbox (GMAIL_INBOX): test VMs read the test emails over IMAP,
# and shadow mode reads new order emails with it.
GMAIL_INBOX_APP_PASSWORD=

# Durable Actors server in WSL (npm run actors:dev): shadow mode and buyer approvals.
ACTORS_URL=http://127.0.0.1:7100
# How often shadow mode checks the inbox and Odoo, and when an unanswered approval gets a reminder.
SHADOW_POLL_MS=15000
APPROVAL_REMIND_MS=120000
